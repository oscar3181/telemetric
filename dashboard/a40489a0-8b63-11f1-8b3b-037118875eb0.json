              "useMarkdownTextFunction" : false,
              "markdownTextPattern" : "<div class=\"scada-container\">\n<div class=\"scada-visual\">\n<svg viewBox=\"0 0 400 400\" width=\"100%\" height=\"100%\">\n<style>\n@keyframes flow {\nto { stroke-dashoffset: -20; }\n}\n@keyframes spin {\nfrom { transform: rotate(0deg); }\nto { transform: rotate(360deg); }\n}\n.pipe-bg {\nstroke: #1e1e2f;\nstroke-width: 14;\nfill: none;\nstroke-linecap: round;\nstroke-linejoin: round;\n}\n.pipe-water {\nstroke: #00bcd4;\nstroke-width: 8;\nfill: none;\nstroke-linecap: round;\nstroke-linejoin: round;\nstroke-dasharray: 10 15;\nanimation: flow 1.5s linear infinite;\n}\n.pump-propeller {\ntransform-origin: 130px 330px;\nanimation: spin 1s linear infinite;\nstroke: #ff9800;\nstroke-width: 4;\n}\n.tank-border {\nfill: none;\nstroke: #888;\nstroke-width: 6;\n}\n.tank-water {\nfill: #0288d1;\nopacity: 0.7;\n}\n</style>\n<path class=\"pipe-bg\" d=\"M 130 240 L 130 330 L 280 330 L 280 80 L 180 80\" />\n<path class=\"pipe-water\" d=\"M 130 240 L 130 330 L 280 330 L 280 80 L 180 80\" />\n<rect x=\"60\" y=\"50\" width=\"140\" height=\"200\" rx=\"10\" ry=\"10\" fill=\"#1b1b24\" stroke=\"#555\" stroke-width=\"2\" />\n<rect class=\"tank-water\" x=\"63\" y=\"100\" width=\"134\" height=\"147\" rx=\"5\" ry=\"5\" />\n<rect class=\"tank-border\" x=\"60\" y=\"50\" width=\"140\" height=\"200\" rx=\"10\" ry=\"10\" />\n<circle cx=\"130\" cy=\"330\" r=\"25\" fill=\"#333\" stroke=\"#ff9800\" stroke-width=\"3\" />\n<line class=\"pump-propeller\" x1=\"130\" y1=\"315\" x2=\"130\" y2=\"345\" />\n<line class=\"pump-propeller\" x1=\"115\" y1=\"330\" x2=\"145\" y2=\"330\" />\n<circle cx=\"130\" cy=\"330\" r=\"5\" fill=\"#fff\" />\n<text x=\"130\" y=\"160\" fill=\"#fff\" font-size=\"14\" font-weight=\"bold\" text-anchor=\"middle\">DEPÓSITO</text>\n<text x=\"130\" y=\"380\" fill=\"#ff9800\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">BOMBA RECIRCULACIÓN</text>\n</svg>\n</div>\n<div class=\"scada-panel\">\n<div class=\"panel-header\">PANEL DE CONTROL</div>\n<div class=\"panel-grid\">\n<div class=\"panel-card green\">\n<div class=\"card-label\">Cloro</div>\n<div class=\"card-value\">${cloro:2} <span class=\"card-unit\">mg/L</span></div>\n</div>\n<div class=\"panel-card blue\">\n<div class=\"card-label\">pH</div>\n<div class=\"card-value\">${ph:2}</div>\n</div>\n<div class=\"panel-card orange\">\n<div class=\"card-label\">Temperatura</div>\n<div class=\"card-value\">${temperatura:1} <span class=\"card-unit\">°C</span></div>\n</div>\n<div class=\"panel-card cyan\">\n<div class=\"card-label\">Redox</div>\n<div class=\"card-value\">${redox:0} <span class=\"card-unit\">mV</span></div>\n</div>\n<div class=\"panel-card purple\">\n<div class=\"card-label\">Turbidez</div>\n<div class=\"card-value\">${turbidez:2} <span class=\"card-unit\">NTU</span></div>\n</div>\n<div class=\"panel-card teal\">\n<div class=\"card-label\">Conductividad</div>\n<div class=\"card-value\">${Conductividad:2} <span class=\"card-unit\">mS/cm</span></div>\n</div>\n</div>\n</div>\n</div>",
              "markdownTextFunction" : "return '# Some title\\\\n - Entity name: ' + data[0]['entityName'];",
