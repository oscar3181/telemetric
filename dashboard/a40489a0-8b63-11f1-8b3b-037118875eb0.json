              "markdownCss" : ".scada-container {\n  display: flex;\n  flex-direction: row;\n  background-color: #111118;\n  border-radius: 8px;\n  padding: 15px;\n  gap: 20px;\n  height: 100%;\n  color: #fff;\n  font-family: 'Roboto', sans-serif;\n  box-sizing: border-box;\n}\n.scada-visual {\n  flex: 1.2;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #181824;\n  border-radius: 8px;\n  border: 1px solid #2e2e42;\n  padding: 10px;\n}\n.scada-panel {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 15px;\n  background-color: #181824;\n  border-radius: 8px;\n  border: 1px solid #2e2e42;\n  padding: 20px;\n  justify-content: center;\n}\n.panel-header {\n  font-size: 18px;\n  font-weight: bold;\n  letter-spacing: 1px;\n  color: #ff9800;\n  text-align: center;\n  border-bottom: 2px solid #2e2e42;\n  padding-bottom: 10px;\n}\n.panel-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 12px;\n}\n.panel-card {\n  background-color: #212130;\n  border-radius: 6px;\n  padding: 12px;\n  border-left: 4px solid #fff;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.panel-card.green { border-left-color: #4caf50; }\n.panel-card.blue { border-left-color: #2196f3; }\n.panel-card.orange { border-left-color: #ff9800; }\n.panel-card.cyan { border-left-color: #00bcd4; }\n.panel-card.purple { border-left-color: #9c27b0; }\n.panel-card.teal { border-left-color: #009688; }\n\n.card-label {\n  font-size: 11px;\n  text-transform: uppercase;\n  color: #8f8fbc;\n  margin-bottom: 4px;\n  font-weight: 500;\n}\n.card-value {\n  font-size: 20px;\n  font-weight: bold;\n}\n.card-unit {\n  font-size: 12px;\n  color: #8f8fbc;\n  font-weight: normal;\n}"
