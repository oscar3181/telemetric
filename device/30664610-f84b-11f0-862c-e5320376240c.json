      "expression" : "var totalPurgaMs = 0;\nvar duracionEventoActualMs = 0;\n\nvar purgando = false;\nvar inicioPurgaTs = 0;\n\nvar contadorSubidas = 0;\nvar toleranciaSubida = 5;      // µS/cm\nvar lecturasParaCerrar = 3;    // subidas consecutivas\n\nvar count = conductividad.size;\n\nif (count > 1) {\n\n    for (var i = 1; i < count; i++) {\n\n        var prev = conductividad.values[i - 1];\n        var curr = conductividad.values[i];\n\n        if (!isNaN(prev.value) && !isNaN(curr.value)) {\n\n            // INICIO DE PURGA\n            // Cruce de 2000 µS/cm hacia abajo\n            if (!purgando &&\n                prev.value >= 2000 &&\n                curr.value < 2000) {\n\n                purgando = true;\n                inicioPurgaTs = prev.ts;\n                contadorSubidas = 0;\n            }\n\n            // PURGA EN CURSO\n            if (purgando) {\n\n                // Si la conductividad sube claramente\n                if (curr.value > prev.value + toleranciaSubida) {\n\n                    contadorSubidas++;\n\n                } else {\n\n                    // Si vuelve a bajar o prácticamente se mantiene,\n                    // anulamos el intento de cierre\n                    contadorSubidas = 0;\n                }\n\n                // FIN DE PURGA:\n                // 3 lecturas consecutivas claramente ascendentes\n                if (contadorSubidas >= lecturasParaCerrar) {\n\n                    // Tomamos como final aproximado el instante\n                    // anterior al inicio de la subida sostenida\n                    var indiceFin = i - lecturasParaCerrar;\n\n                    if (indiceFin < 0) {\n                        indiceFin = 0;\n                    }\n\n                    var finPurgaTs =\n                        conductividad.values[indiceFin].ts;\n\n                    var duracion =\n                        finPurgaTs - inicioPurgaTs;\n\n                    if (duracion > 0) {\n                        totalPurgaMs += duracion;\n                    }\n\n                    purgando = false;\n                    inicioPurgaTs = 0;\n                    contadorSubidas = 0;\n                }\n            }\n        }\n    }\n\n    // Si al terminar el periodo consultado\n    // todavía estamos dentro de una purga\n    if (purgando && inicioPurgaTs > 0) {\n\n        var ultimoTs =\n            conductividad.values[count - 1].ts;\n\n        duracionEventoActualMs =\n            ultimoTs - inicioPurgaTs;\n\n        if (duracionEventoActualMs > 0) {\n            totalPurgaMs += duracionEventoActualMs;\n        }\n    }\n}\n\nreturn {\n\n    \"tiempo_purga_24h_min\":\n        toFixed(totalPurgaMs / 60000.0, 2),\n\n    \"tiempo_purga_24h_h\":\n        toFixed(totalPurgaMs / 3600000.0, 2),\n\n    \"duracion_purga_actual_min\":\n        toFixed(duracionEventoActualMs / 60000.0, 2),\n\n    \"en_purga\":\n        purgando\n};"
    },
